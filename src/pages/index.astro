---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('research');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);

const pressLogos = [
  { name: 'Financial Times', file: 'financial-times.svg' },
  { name: 'Bloomberg', file: 'bloomberg.svg' },
  { name: 'Wall Street Journal', file: 'wsj.svg' },
  { name: 'Reuters', file: 'reuters.svg' },
  { name: 'The Economist', file: 'economist.svg' },
  { name: 'TechCrunch', file: 'techcrunch.svg' },
];
---

<BaseLayout title="Norwell Research — Strategic market intelligence." description="Independent analysis of payments infrastructure, digital banking, DeFi protocols, and capital markets technology — from embedded finance to tokenized assets." pageType="homepage">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__orb hero__orb--3"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__kicker"><span class="pulse-dot"></span> Financial Technology Research &middot; Independent</span>
        <h1 class="hero__title"><span class="gradient-text">Fintech Intelligence</span> for Institutional Decision-Makers</h1>
        <p class="hero__sub">Independent analysis of payments infrastructure, digital banking, DeFi protocols, and capital markets technology — from embedded finance to tokenized assets.</p>
        <div class="hero__ctas">
          <a href="/research" class="btn">Browse Research</a>
          <a href="/contact" class="btn btn--outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">Request a Brief</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PRESS STRIP ═══ -->
  <div class="press-strip">
    <div class="container">
      <p class="press-label">As featured in</p>
      <div class="press-logos">
        {pressLogos.map(logo => (
          <a href={`https://www.${logo.name.toLowerCase().replace(/ /g, '')}.com`} target="_blank" rel="noopener" class="press-logo-link">
            <img src={`/logos/${logo.file}`} alt={logo.name} class="press-logo-img" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ SIGNAL BAR ═══ -->
  <div class="signal-bar">
    <div class="signal-bar__label"><span class="pulse-dot pulse-dot--green"></span> LIVE</div>
    <div class="signal-bar__track">
      <div class="signal-bar__content">
        <span class="signal-bar__item">Embedded Finance Market: $138B transaction volume in H1 2026</span>
        <span class="signal-bar__item">Digital Banking Penetration: 4.2B global digital bank accounts, up 22% YoY</span>
        <span class="signal-bar__item">Tokenized Real-World Assets: $18.4B on-chain, led by treasuries and real estate</span>
        <span class="signal-bar__item">Real-Time Payments: 72 countries now have instant payment infrastructure</span>
        <span class="signal-bar__item">Open Banking API Calls: 48B monthly API calls across EU and UK markets</span>
        <span class="signal-bar__item">Stablecoin Settlement: $2.1T settled in H1 2026 across B2B and cross-border</span>
        <span class="signal-bar__item">Embedded Finance Market: $138B transaction volume in H1 2026</span>
        <span class="signal-bar__item">Digital Banking Penetration: 4.2B global digital bank accounts, up 22% YoY</span>
        <span class="signal-bar__item">Tokenized Real-World Assets: $18.4B on-chain, led by treasuries and real estate</span>
        <span class="signal-bar__item">Real-Time Payments: 72 countries now have instant payment infrastructure</span>
        <span class="signal-bar__item">Open Banking API Calls: 48B monthly API calls across EU and UK markets</span>
        <span class="signal-bar__item">Stablecoin Settlement: $2.1T settled in H1 2026 across B2B and cross-border</span>
      </div>
    </div>
  </div>

  <!-- ═══ STATS ═══ -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-card__num">380+</span>
          <span class="stat-card__label">Fintech Reports</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">56</span>
          <span class="stat-card__label">Market Segments</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">200+</span>
          <span class="stat-card__label">Client Institutions</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">1,400+</span>
          <span class="stat-card__label">Vendor Profiles</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED REPORT ═══ -->
  <section class="section section--dark">
    <div class="container report-spotlight">
      <div class="report-spotlight__info">
        <span class="report-spotlight__label">Featured Report</span>
        <h2>Payments Infrastructure Benchmark Q3 2026</h2>
        <p>Evaluation of 22 payments platforms across settlement speed, fraud prevention, cross-border capability, and API reliability.</p>
        <div class="report-spotlight__meta">
          <span>Research Team</span><span>48 pages</span><span>24 vendors scored</span><span>Jul 2026</span>
        </div>
        <a href="/research" class="btn">Read the Report</a>
      </div>
      <div class="report-spotlight__card">
        <div class="report-mockup">
          <span class="report-mockup__badge">Financial Technology</span>
          <h3 class="report-mockup__title">Payments Infrastructure Benchmark Q3 2026</h3>
          <div class="report-mockup__divider"></div>
          <div class="report-mockup__bars">
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Settlement Speed</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:91%"></div></div>
              <span class="report-mockup__bar-val">91%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Fraud Prevention</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:78%"></div></div>
              <span class="report-mockup__bar-val">78%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Cross-Border Capability</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:65%"></div></div>
              <span class="report-mockup__bar-val">65%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">API Reliability</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:84%"></div></div>
              <span class="report-mockup__bar-val">84%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LATEST RESEARCH ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <span class="section__label">Latest Intelligence</span>
          <h2>Recent Financial Technology Research</h2>
        </div>
        <a href="/research" class="link-arrow">View all research &rarr;</a>
      </div>
      {posts.length > 0 ? (
        <div class="article-grid">
          {posts.map(post => (
            <ArticleCard title={post.data.title} slug={post.id} category={post.data.category}
              description={post.data.description} author={post.data.author} date={post.data.date}
              featured_image={post.data.featured_image} />
          ))}
        </div>
      ) : (
        <div class="insights-grid">
          <article class="insight-card">
            <span class="insight-card__tag">Market Report</span>
            <h3>Embedded Finance: Who Controls the Distribution Layer?</h3>
            <span class="insight-card__meta">Jul 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>Tokenized Treasuries: Yield, Liquidity, and Institutional Adoption</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Primer</span>
            <h3>Open Banking 2.0: Variable Recurring Payments and Commercial Use Cases</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Report</span>
            <h3>Cross-Border Payments: SWIFT gpi vs Ripple vs Stablecoin Settlement</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Benchmark</span>
            <h3>Core Banking Platforms: Cloud Migration Readiness Scorecard</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>AI in Credit Decisioning: Accuracy, Bias, and Regulatory Compliance</h3>
            <span class="insight-card__meta">Apr 2026</span>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ INSIGHTS FEED ═══ -->
  <section class="section section--soft">
    <div class="container">
      <span class="section__label">Market Commentary</span>
      <h2 style="margin-bottom:1.5rem;">Financial Technology Insights Feed</h2>
      <div class="feed-list">
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Market Report</span>
          <span class="feed-item__title">Embedded Finance: Who Controls the Distribution Layer?</span>
          <span class="feed-item__date">Jul 2026</span>
        </a>
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">Tokenized Treasuries: Yield, Liquidity, and Institutional Adoption</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Primer</span>
          <span class="feed-item__title">Open Banking 2.0: Variable Recurring Payments and Commercial Use Cases</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Report</span>
          <span class="feed-item__title">Cross-Border Payments: SWIFT gpi vs Ripple vs Stablecoin Settlement</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Core Banking Platforms: Cloud Migration Readiness Scorecard</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/research" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI in Credit Decisioning: Accuracy, Bias, and Regulatory Compliance</span>
          <span class="feed-item__date">Apr 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header" style="text-align:center;">
        <span class="section__label">Our Services</span>
        <h2>Intelligence That Moves Decisions</h2>
      </div>
      <div class="services-grid">
        <div class="service-card"><h3>Market Intelligence</h3><p>Comprehensive sector reports and competitive analysis.</p></div>
        <div class="service-card"><h3>Due Diligence</h3><p>Technical and commercial assessment for M&A decisions.</p></div>
        <div class="service-card"><h3>Custom Research</h3><p>Bespoke programs tailored to your strategic questions.</p></div>
        <div class="service-card"><h3>Advisory Retainers</h3><p>Ongoing strategic monitoring and analyst access.</p></div>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section class="section section--dark">
    <div class="container newsletter-section">
      <div class="newsletter-section__content">
        <h2>Get the <span class="gradient-text">Fintech Briefing</span></h2>
        <p>Weekly research digest with key findings, market signals, and analysis — delivered to your inbox.</p>
        <div class="newsletter-section__proof">
          <span>2,400+ subscribers</span><span>82% open rate</span><span>Free forever</span>
        </div>
      </div>
      <div class="newsletter-section__form">
        <NewsletterSignup />
      </div>
    </div>
  </section>

</BaseLayout>
