---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pageType?: 'homepage' | 'article' | 'default';
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Norwell Research provides independent strategic market research and intelligence across key industry verticals.',
  pageType = 'default',
  canonicalUrl = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  noindex = false,
} = Astro.props;

const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://norwellresearch.com${ogImage}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Norwell Research',
  url: 'https://norwellresearch.com',
  description: 'Norwell Research provides independent strategic market research and intelligence across key industry verticals.',
  logo: { '@type': 'ImageObject', url: 'https://norwellresearch.com/favicon.svg' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1 Federal Street, Suite 2400',
    addressLocality: 'Boston',
    addressRegion: 'MA',
    postalCode: '02110',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-617-555-0203',
    contactType: 'customer service',
    email: 'research@norwellresearch.com',
  },
};

const pageTitle = title.split(' — ')[0].split(' | ')[0];
const breadcrumbSchema = pageType !== 'homepage' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://norwellresearch.com' },
    { '@type': 'ListItem', position: 2, name: pageTitle, item: canonicalUrl },
  ],
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://research-api.n311311.workers.dev; frame-ancestors 'none';" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:site_name" content="Norwell Research" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <slot name="schema" />
    <script>
      (function(){
        var site=location.hostname, path=location.pathname, referrer=document.referrer;
        fetch('https://research-api.n311311.workers.dev/api/analytics/pageview',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({site:site,path:path,referrer:referrer})}).catch(function(){});
        window.addEventListener('error',function(e){
          fetch('https://research-api.n311311.workers.dev/api/analytics/error',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({site:site,path:path,message:e.message,stack:e.error&&e.error.stack?e.error.stack:''})}).catch(function(){});
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
